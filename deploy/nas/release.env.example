# Non-secret values. Fill only AFTER reviewed release build. Do not use :dev for rollout.
BACKEND_IMAGE=
FRONTEND_IMAGE=
OPS_RELEASE_DIR=/volume1/docker/basel-homefixer/ops/releases/mvp-20261025
NAS_CONTENT_ROOT=/volume1/docker/basel-homefixer/content
# Confirm exact socket peers for the existing cloudflared -> Traefik path before release.
# No 10/8, 172.16/12 or 192.168/16 catch-all ranges.
EDGE_TRUSTED_IPS=
# Empty is safe but shares a proxy rate limit. Set only verified complete trusted hops.
CONTACT_TRUSTED_PROXIES=
# Deliberately disabled for dry-run/staging. Activation + real mail require separate approval.
CONTACT_MAIL_ENABLED=false
