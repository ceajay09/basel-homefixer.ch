# Server only. Generate once from 32 cryptographically random bytes and store persistently.
# Empty means sign-in unavailable; no default signing key exists.
AUTH_JWT_SECRET_BASE64=
# 60..3600 seconds; default is 15 minutes. No refresh tokens in this step.
AUTH_TOKEN_TTL_SECONDS=900
# Default: no public registration. If enabled, requires the reviewed unique email index.
AUTH_PUBLIC_REGISTRATION_ENABLED=false
# Explicit local setup/reset only. Never read from frontend or committed configuration.
AUTH_SETUP_MONGO_URI=
