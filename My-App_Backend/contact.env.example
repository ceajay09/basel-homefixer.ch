# Example only; keep real values in the NAS/server secret configuration, outside Git.
CONTACT_MAIL_ENABLED=false
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SSL=false
CONTACT_SMTP_PASSWORD=
# Comma-separated exact socket-peer addresses of trusted reverse proxies, no wildcard/CIDR.
CONTACT_TRUSTED_PROXIES=
